{
  "manifest_version": 3,
  "name": "AI Chat Assistant",
  "version": "1.2.0",
  "description": "Assistente AI per suggerire risposte nelle chat",
  "permissions": ["activeTab", "clipboardWrite", "storage"],
  "action": {
    "default_title": "AI Chat Assistant - Impostazioni"
  },
  "content_scripts": [
    {
      "matches": ["https://dashboard.usechatterly.com/message*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["bootstrap.min.css", "bootstrap-icons.min.css", "bootstrap.bundle.min.js", "fonts/*"],
      "matches": ["https://dashboard.usechatterly.com/*"]
    }
  ]
}
